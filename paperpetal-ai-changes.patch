[32m+[m
[32m+[m[32m  const handleRegenerate = () => {[m
[32m+[m[32m    setLoaded(false);[m
[32m+[m[32m    setError(false);[m
[32m+[m[32m    setImageUrl('');[m
[32m+[m[32m    if (generateFn) {[m
[32m+[m[32m      setGenerating(true);[m
[32m+[m[32m      generateFn().then(url => {[m
[32m+[m[32m        if (url) {[m
[32m+[m[32m          setImageUrl(url);[m
[32m+[m[32m        } else {[m
[32m+[m[32m          setError(true);[m
[32m+[m[32m        }[m
[32m+[m[32m        setGenerating(false);[m
