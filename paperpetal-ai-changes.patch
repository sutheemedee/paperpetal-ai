[32m+[m[32m          className="absolute top-2 right-2 rounded-md border border-border bg-background/90 px-2 py-1 text-[11px] font-ui cursor-pointer hover:bg-card transition-colors"[m
[32m+[m[32m        >[m
[32m+[m[32m          🔄 สร้างใหม่[m
[32m+[m[32m        </button>[m
[32m+[m[32m      )}[m
