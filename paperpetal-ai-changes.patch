[32m+[m[32m  return ([m
[32m+[m[32m    <div className={`relative overflow-hidden rounded-lg ${className || ''}`} style={{ width, height }}>[m
[32m+[m[32m      {(!loaded || generating) && !error && ([m
[32m+[m[32m        <div className="shimmer-bg absolute inset-0 flex items-center justify-center rounded-lg">[m
[32m+[m[32m          <span className="text-xs text-muted-foreground font-ui">[m
[32m+[m[32m            {generating ? 'กำลังสร้างภาพ AI...' : 'กำลังโหลดภาพ...'}[m
[32m+[m[32m          </span>[m
[32m+[m[32m        </div>[m
[32m+[m[32m      )}[m
[32m+[m[32m      {error && ([m
[32m+[m[32m        <div[m
[32m+[m[32m          className="absolute inset-0 flex flex-col items-center justify-center rounded-lg gap-2"[m
[32m+[m[32m          style={{ background: 'linear-gradient(135deg, hsl(48 100% 50%), hsl(43 100% 82%))' }}[m
[32m+[m[32m        >[m
[32m+[m[32m          <span className="text-xs text-primary-foreground font-ui">ไม่สามารถสร้างภาพได้</span>[m
[32m+[m[32m          {(generateFn || onRegenerate) && ([m
[32m+[m[32m            <button[m
[32m+[m[32m              onClick={handleRegenerate}[m
[32m+[m[32m              className="rounded-md border border-border bg-background/90 px-2 py-1 text-[11px] font-ui cursor-pointer hover:bg-card transition-colors"[m
[32m+[m[32m            >[m
