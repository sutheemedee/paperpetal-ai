[32m+[m[32m--- exportEpub ---[m
[32m+[m[32mimport JSZip from 'jszip';[m
[32m+[m[32mimport { saveAs } from 'file-saver';[m
[32m+[m
[32m+[m[32mconst esc = (s: string) =>[m
[32m+[m[32m  String(s || '')[m
[32m+[m[32m    .replace(/&/g, '&amp;')[m
[32m+[m[32m    .replace(/</g, '&lt;')[m
[32m+[m[32m    .replace(/>/g, '&gt;');[m
[32m+[m
[32m+[m[32mconst paras = (body: string) =>[m
[32m+[m[32m  String(body || '')[m
[32m+[m[32m    .split(/\n{1,}/)[m
[32m+[m[32m    .filter(Boolean)[m
[32m+[m[32m    .map(p => `<p>${esc(p)}</p>`)[m
[32m+[m[32m    .join('\n');[m
[32m+[m
[32m+[m[32mconst dataUrlToBytes = (url: string): { bytes: Uint8Array; ext: string } | null => {[m
[32m+[m[32m  const match = /^data:image\/(png|jpeg|jpg|webp);base64,(.*)$/i.exec(url);[m
[32m+[m[32m  if (!match) return null;[m
[32m+[m[32m  const binary = atob(match[2]);[m
[32m+[m[32m  const bytes = new Uint8Array(binary.length);[m
[32m+[m[32m  for (let i = 0; i < binary.length; i++) bytes[i] = binary.charCodeAt(i);[m
[32m+[m[32m  return { bytes, ext: match[1].toLowerCase() === 'jpg' ? 'jpeg' : match[1].toLowerCase() };[m
[32m+[m[32m};[m
[32m+[m
[32m+[m[32mconst fetchImageBytes = async (url: string) => {[m
[32m+[m[32m  if (!url) return null;[m
[32m+[m[32m  const inline = dataUrlToBytes(url);[m
[32m+[m[32m  if (inline) return inline;[m
[32m+[m[32m  try {[m
[32m+[m[32m    const res = await fetch(url);[m
[32m+[m[32m    const buf = new Uint8Array(await res.arrayBuffer());[m
[32m+[m[32m    const type = res.headers.get('content-type') || 'image/png';[m
[32m+[m[32m    return { bytes: buf, ext: type.includes('jpeg') ? 'jpeg' : type.includes('webp') ? 'webp' : 'png' };[m
[32m+[m[32m  } catch {[m
[32m+[m[32m    return null;[m
[32m+[m[32m  }[m
[32m+[m[32m};[m
[32m+[m
[32m+[m[32minterface EpubOptions {[m
[32m+[m[32m  coverImageUrl?: string;[m
[32m+[m[32m  chapterImages?: Record<number, string>;[m
[32m+[m[32m}[m
[32m+[m
[32m+[m[32mconst CSS = `body{font-family:serif;line-height:1.75;margin:1.2em}[m
[32m+[m[32mh1,h2,h3{font-family:serif;line-height:1.3}[m
[32m+[m[32m.eyebrow{letter-spacing:.2em;text-transform:uppercase;font-size:.75em;opacity:.6}[m
[32m+[m[32mimg{max-width:100%;height:auto;border-radius:6px}[m
[32m+[m[32m.center{text-align:center}`;[m
[32m+[m
[32m+[m[32mexport const exportToEpub = async (bookData: any, options: EpubOptions = {}) => {[m
[32m+[m[32m  const zip = new JSZip();[m
[32m+[m[32m  zip.file('mimetype', 'application/epub+zip', { compression: 'STORE' });[m
[32m+[m[32m  zip.file([m
[32m+[m[32m    'META-INF/container.xml',[m
[32m+[m[32m    `<?xml version="1.0" encoding="UTF-8"?>[m
[32m+[m[32m<container version="1.0" xmlns="urn:oasis:names:tc:opendocument:xmlns:container">[m
[32m+[m[32m  <rootfiles><rootfile full-path="OEBPS/content.opf" media-type="application/oebps-package+xml"/></rootfiles>[m
[32m+[m[32m</container>`,[m
[32m+[m[32m  );[m
[32m+[m
[32m+[m[32m  const oebps = zip.folder('OEBPS')!;[m
[32m+[m[32m  oebps.file('style.css', CSS);[m
[32m+[m
[32m+[m[32m  const manifest: string[] = [`<item id="css" href="style.css" media-type="text/css"/>`];[m
[32m+[m[32m  const spine: string[] = [];[m
[32m+[m[32m  const nav: string[] = [];[m
[32m+[m
[32m+[m[32m  // Cover image[m
[32m+[m[32m  let coverMeta = '';[m
[32m+[m[32m  const cover = await fetchImageBytes(options.coverImageUrl || '');[m
[32m+[m[32m  if (cover) {[m
[32m+[m[32m    oebps.file(`images/cover.${cover.ext}`, cover.bytes);[m
[32m+[m[32m    manifest.push(`<item id="cover-image" href="images/cover.${cover.ext}" media-type="image/${cover.ext}" properties="cover-image"/>`);[m
[32m+[m[32m    coverMeta = `<meta name="cover" content="cover-image"/>`;[m
[32m+[m[32m  }[m
[32m+[m
[32m+[m[32m  const addDoc = (id: string, filename: string, title: string, body: string) => {[m
[32m+[m[32m    oebps.file([m
[32m+[m[32m      filename,[m
[32m+[m[32m      `<?xml version="1.0" encoding="UTF-8"?>[m
[32m+[m[32m<!DOCTYPE html>[m
[32m+[m[32m<html xmlns="http://www.w3.org/1999/xhtml" xml:lang="th"><head>[m
[32m+[m[32m<meta charset="utf-8"/><title>${esc(title)}</title><link rel="stylesheet" type="text/css" href="style.css"/>[m
[32m+[m[32m</head><body>${body}</body></html>`,[m
[32m+[m[32m    );[m
[32m+[m[32m    manifest.push(`<item id="${id}" href="${filename}" media-type="application/xhtml+xml"/>`);[m
[32m+[m[32m    spine.push(`<itemref idref="${id}"/>`);[m
[32m+[m[32m    nav.push(`<li><a href="${filename}">${esc(title)}</a></li>`);[m
[32m+[m[32m  };[m
[32m+[m
[32m+[m[32m  addDoc([m
[32m+[m[32m    'titlepage',[m
[32m+[m[32m    'titlepage.xhtml',[m
[32m+[m[32m    bookData.title || 'E-Book',[m
[32m+[m[32m    `<div class="center">[m
[32m+[m[32m      ${cover ? `<img src="images/cover.${cover.ext}" alt="cover"/>` : ''}[m
[32m+[m[32m      <h1>${esc(bookData.title)}</h1>[m
[32m+[m[32m      <p>${esc(bookData.subtitle || '')}</p>[m
[32m+[m[32m      <p class="eyebrow">${esc(bookData.author || '')}</p>[m
[32m+[m[32m    </div>`,[m
[32m+[m[32m  );[m
[32m+[m
[32m+[m[32m  let idx = 0;[m
[32m+[m[32m  for (const chapter of bookData.chapters || []) {[m
[32m+[m[32m    idx++;[m
[32m+[m[32m    const img = await fetchImageBytes(options.chapterImages?.[chapter.chapterNumber] || '');[m
[32m+[m[32m    let imgTag = '';[m
[32m+[m[32m    if (img) {[m
[32m+[m[32m      const name = `images/ch${idx}.${img.ext}`;[m
[32m+[m[32m      oebps.file(name, img.bytes);[m
[32m+[m[32m      manifest.push(`<item id="img-ch${idx}" href="${name}" media-type="image/${img.ext}"/>`);[m
[32m+[m[32m      imgTag = `<img src="${name}" alt="${esc(chapter.chapterTitle)}"/>`;[m
[32m+[m[32m    }[m
[32m+[m
[32m+[m[32m    const pagesHtml: string[] = [];[m
[32m+[m[32m    for (const page of chapter.pages || []) {[m
[32m+[m[32m      let pageImg = '';[m
[32m+[m[32m      const pi = await fetchImageBytes(page.imageUrl || '');[m
[32m+[m[32m      if (pi) {[m
[32m+[m[32m        const name = `images/ch${idx}-p${page.pageNumber}.${pi.ext}`;[m
[32m+[m[32m        oebps.file(name, pi.bytes);[m
[32m+[m[32m        manifest.push(`<item id="img-ch${idx}p${page.pageNumber}" href="${name}" media-type="image/${pi.ext}"/>`);[m
[32m+[m[32m        pageImg = `<img src="${name}" alt="${esc(page.heading || 'illustration')}"/>`;[m
[32m+[m[32m      }[m
[32m+[m[32m      pagesHtml.push(`${page.heading ? `<h3>${esc(page.heading)}</h3>` : ''}${pageImg}${paras(page.body)}`);[m
[32m+[m[32m    }[m
[32m+[m
[32m+[m[32m    addDoc([m
[32m+[m[32m      `chap${idx}`,[m
[32m+[m[32m      `chap${idx}.xhtml`,[m
[32m+[m[32m      `บทที่ ${chapter.chapterNumber}: ${chapter.chapterTitle}`,[m
[32m+[m[32m      `${imgTag}<p class="eyebrow">บทที่ ${chapter.chapterNumber}</p><h2>${esc(chapter.chapterTitle)}</h2>${pagesHtml.join('\n')}`,[m
[32m+[m[32m    );[m
[32m+[m[32m  }[m
[32m+[m
[32m+[m[32m  addDoc('conclusion', 'conclusion.xhtml', 'สรุป', `<h2>สรุป</h2>${paras(bookData.conclusion)}`);[m
[32m+[m
[32m+[m[32m  oebps.file([m
[32m+[m[32m    'nav.xhtml',[m
[32m+[m[32m    `<?xml version="1.0" encoding="UTF-8"?>[m
[32m+[m[32m<!DOCTYPE html>[m
[32m+[m[32m<html xmlns="http://www.w3.org/1999/xhtml" xmlns:epub="http://www.idpf.org/2007/ops" xml:lang="th"><head>[m
[32m+[m[32m<meta charset="utf-8"/><title>สารบัญ</title></head><body>[m
[32m+[m[32m<nav epub:type="toc" id="toc"><h1>สารบัญ</h1><ol>${nav.join('')}</ol></nav>[m
[32m+[m[32m</body></html>`,[m
[32m+[m[32m  );[m
[32m+[m[32m  manifest.push(`<item id="nav" href="nav.xhtml" media-type="application/xhtml+xml" properties="nav"/>`);[m
[32m+[m
[32m+[m[32m  const uid = `urn:uuid:${crypto.randomUUID()}`;[m
[32m+[m[32m  oebps.file([m
[32m+[m[32m    'content.opf',[m
[32m+[m[32m    `<?xml version="1.0" encoding="UTF-8"?>[m
[32m+[m[32m<package xmlns="http://www.idpf.org/2007/opf" version="3.0" unique-identifier="bookid">[m
[32m+[m[32m  <metadata xmlns:dc="http://purl.org/dc/elements/1.1/">[m
[32m+[m[32m    <dc:identifier id="bookid">${uid}</dc:identifier>[m
[32m+[m[32m    <dc:title>${esc(bookData.title)}</dc:title>[m
[32m+[m[32m    <dc:creator>${esc(bookData.author || 'AI E-Book Studio')}</dc:creator>[m
[32m+[m[32m    <dc:language>th</dc:language>[m
[32m+[m[32m    <dc:description>${esc(bookData.description || bookData.subtitle || '')}</dc:description>[m
[32m+[m[32m    <meta property="dcterms:modified">${new Date().toISOString().replace(/\.\d+Z$/, 'Z')}</meta>[m
[32m+[m[32m    ${coverMeta}[m
[32m+[m[32m  </metadata>[m
[32m+[m[32m  <manifest>${manifest.join('')}</manifest>[m
[32m+[m[32m  <spine>${spine.join('')}</spine>[m
[32m+[m[32m</package>`,[m
[32m+[m[32m  );[m
[32m+[m
[32m+[m[32m  const blob = await zip.generateAsync({ type: 'blob', mimeType: 'application/epub+zip' });[m
[32m+[m[32m  saveAs(blob, `${bookData.title || 'ebook'}.epub`);[m
[32m+[m[32m};[m
[32m+[m[32m--- exportPdf ---[m
[32m+[m[32mimport jsPDF from 'jspdf';[m
[32m+[m[32mimport html2canvas from 'html2canvas';[m
[32m+[m[32mimport type { BookSize } from './bookSizes';[m
[32m+[m
[32m+[m[32mconst esc = (s: string) =>[m
[32m+[m[32m  String(s || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');[m
[32m+[m
[32m+[m[32minterface PdfOptions {[m
[32m+[m[32m  coverImageUrl?: string;[m
[32m+[m[32m  chapterImages?: Record<number, string>;[m
[32m+[m[32m}[m
[32m+[m
[32m+[m[32m/**[m
[32m+[m[32m * Renders each book page as an offscreen HTML node, rasterises it with html2canvas[m
[32m+[m[32m * (so Thai typography is preserved) and stitches everything into a PDF.[m
[32m+[m[32m */[m
[32m+[m[32mexport const exportToPdf = async ([m
[32m+[m[32m  bookData: any,[m
[32m+[m[32m  bookSize: BookSize,[m
[32m+[m[32m  options: PdfOptions = {},[m
[32m+[m[32m  onProgress?: (pct: number, label: string) => void,[m
[32m+[m[32m) => {[m
[32m+[m[32m  const wMm = bookSize.width || 148;[m
[32m+[m[32m  const hMm = bookSize.height || 210;[m
[32m+[m[32m  const pw = bookSize.pageWidth || 559;[m
[32m+[m[32m  const ph = bookSize.pageHeight || 794;[m
[32m+[m[32m  const m = bookSize.margins;[m
[32m+[m
[32m+[m[32m  const host = document.createElement('div');[m
[32m+[m[32m  host.style.cssText = `position:fixed;left:-10000px;top:0;width:${pw}px;`;[m
[32m+[m[32m  document.body.appendChild(host);[m
[32m+[m
[32m+[m[32m  const makePage = (inner: string, center = false) => {[m
[32m+[m[32m    const el = document.createElement('div');[m
[32m+[m[32m    el.style.cssText = `width:${pw}px;height:${ph}px;box-sizing:border-box;background:#fff;color:#111;[m
[32m+[m[32m      padding:${m.top}px ${m.right}px ${m.bottom}px ${m.left}px;overflow:hidden;[m
[32m+[m[32m      font-family:'Lora',serif;font-size:${bookSize.fontSize}px;line-height:${bookSize.lineHeight};[m
[32m+[m[32m      display:flex;flex-direction:column;${center ? 'justify-content:center;align-items:center;text-align:center;' : ''}`;[m
[32m+[m[32m    el.innerHTML = inner;[m
[32m+[m[32m    host.appendChild(el);[m
[32m+[m[32m    return el;[m
[32m+[m[32m  };[m
[32m+[m
[32m+[m[32m  const pages: HTMLElement[] = [];[m
[32m+[m
[32m+[m[32m  // Cover[m
[32m+[m[32m  pages.push([m
[32m+[m[32m    makePage([m
[32m+[m[32m      `${options.coverImageUrl ? `<img src="${options.coverImageUrl}" style="width:100%;height:55%;object-fit:cover;border-radius:8px" />` : ''}[m
[32m+[m[32m       <h1 style="font-family:'Playfair Display',serif;font-size:${bookSize.fontSize * 2.2}px;margin:24px 0 8px">${esc(bookData.title)}</h1>[m
[32m+[m[32m       <p style="opacity:.75;margin:0">${esc(bookData.subtitle || '')}</p>[m
[32m+[m[32m       <p style="margin-top:24px;letter-spacing:.2em;text-transform:uppercase;font-size:${bookSize.fontSize * 0.8}px">${esc(bookData.author || '')}</p>`,[m
[32m+[m[32m      true,[m
[32m+[m[32m    ),[m
[32m+[m[32m  );[m
[32m+[m
[32m+[m[32m  // Table of contents[m
[32m+[m[32m  pages.push([m
[32m+[m[32m    makePage([m
[32m+[m[32m      `<h2 style="font-family:'Playfair Display',serif;font-size:${bookSize.fontSize * 1.6}px;margin:0 0 20px">สารบัญ</h2>[m
[32m+[m[32m       ${(bookData.chapters || [])[m
