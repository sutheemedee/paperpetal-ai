[32m+[m[32m--- useIllustrations ---[m
[32m+[m[32mimport { useCallback, useState } from 'react';[m
[32m+[m[32mimport { generateChapterImage, generateSectionImage } from '@/utils/imageGen';[m
[32m+[m
[32m+[m[32mexport const pageKey = (chapterNumber: number, pageNumber: number) => `${chapterNumber}-${pageNumber}`;[m
[32m+[m
[32m+[m[32mexport interface IllustrationStore {[m
[32m+[m[32m  chapterImages: Record<number, string>;[m
[32m+[m[32m  pageImages: Record<string, string>;[m
[32m+[m[32m  pending: Record<string, boolean>;[m
[32m+[m[32m  makeChapter: (chapter: any, bookTitle: string) => Promise<void>;[m
[32m+[m[32m  makePage: (chapter: any, page: any, bookTitle: string) => Promise<void>;[m
[32m+[m[32m  makeAll: (bookData: any, onProgress?: (done: number, total: number) => void) => Promise<void>;[m
[32m+[m[32m  reset: () => void;[m
[32m+[m[32m}[m
[32m+[m
[32m+[m[32mexport const useIllustrations = (): IllustrationStore => {[m
[32m+[m[32m  const [chapterImages, setChapterImages] = useState<Record<number, string>>({});[m
[32m+[m[32m  const [pageImages, setPageImages] = useState<Record<string, string>>({});[m
[32m+[m[32m  const [pending, setPending] = useState<Record<string, boolean>>({});[m
[32m+[m
[32m+[m[32m  const mark = (key: string, value: boolean) =>[m
[32m+[m[32m    setPending(prev => ({ ...prev, [key]: value }));[m
[32m+[m
[32m+[m[32m  const makeChapter = useCallback(async (chapter: any, bookTitle: string) => {[m
[32m+[m[32m    const key = `ch-${chapter.chapterNumber}`;[m
[32m+[m[32m    mark(key, true);[m
[32m+[m[32m    const url = await generateChapterImage(chapter.chapterTitle, bookTitle);[m
[32m+[m[32m    if (url) setChapterImages(prev => ({ ...prev, [chapter.chapterNumber]: url }));[m
[32m+[m[32m    mark(key, false);[m
[32m+[m[32m  }, []);[m
[32m+[m
[32m+[m[32m  const makePage = useCallback(async (chapter: any, page: any, bookTitle: string) => {[m
[32m+[m[32m    const key = `pg-${pageKey(chapter.chapterNumber, page.pageNumber)}`;[m
[32m+[m[32m    mark(key, true);[m
[32m+[m[32m    const url = await generateSectionImage([m
[32m+[m[32m      page.heading || chapter.chapterTitle,[m
[32m+[m[32m      page.body || '',[m
[32m+[m[32m      bookTitle,[m
[32m+[m[32m    );[m
[32m+[m[32m    if (url) setPageImages(prev => ({ ...prev, [pageKey(chapter.chapterNumber, page.pageNumber)]: url }));[m
[32m+[m[32m    mark(key, false);[m
[32m+[m[32m  }, []);[m
[32m+[m
[32m+[m[32m  const makeAll = useCallback([m
[32m+[m[32m    async (bookData: any, onProgress?: (done: number, total: number) => void) => {[m
[32m+[m[32m      const chapters = bookData?.chapters || [];[m
[32m+[m[32m      const jobs: (() => Promise<void>)[] = [];[m
[32m+[m[32m      for (const chapter of chapters) {[m
[32m+[m[32m        jobs.push(() => makeChapter(chapter, bookData.title));[m
[32m+[m[32m        for (const page of chapter.pages || []) {[m
[32m+[m[32m          if (page.heading) jobs.push(() => makePage(chapter, page, bookData.title));[m
[32m+[m[32m        }[m
[32m+[m[32m      }[m
[32m+[m[32m      let done = 0;[m
[32m+[m[32m      // small concurrency so the gateway isn't hammered[m
[32m+[m[32m      const workers = Array.from({ length: 3 }, async () => {[m
[32m+[m[32m        while (jobs.length) {[m
[32m+[m[32m          const job = jobs.shift();[m
[32m+[m[32m          if (!job) break;[m
[32m+[m[32m          await job();[m
[32m+[m[32m          done++;[m
[32m+[m[32m          onProgress?.(done, done + jobs.length);[m
[32m+[m[32m        }[m
[32m+[m[32m      });[m
[32m+[m[32m      await Promise.all(workers);[m
[32m+[m[32m    },[m
[32m+[m[32m    [makeChapter, makePage],[m
[32m+[m[32m  );[m
[32m+[m
[32m+[m[32m  const reset = useCallback(() => {[m
[32m+[m[32m    setChapterImages({});[m
[32m+[m[32m    setPageImages({});[m
[32m+[m[32m    setPending({});[m
[32m+[m[32m  }, []);[m
[32m+[m
[32m+[m[32m  return { chapterImages, pageImages, pending, makeChapter, makePage, makeAll, reset };[m
[32m+[m[32m};[m
[32m+[m
[32m+[m[32m/** Merges generated illustrations into the book object so exporters can read them. */[m
[32m+[m[32mexport const hydrateBook = ([m
[32m+[m[32m  bookData: any,[m
[32m+[m[32m  chapterImages: Record<number, string>,[m
[32m+[m[32m  pageImages: Record<string, string>,[m
[32m+[m[32m) => ({[m
[32m+[m[32m  ...bookData,[m
[32m+[m[32m  chapters: (bookData?.chapters || []).map((c: any) => ({[m
[32m+[m[32m    ...c,[m
[32m+[m[32m    imageUrl: chapterImages[c.chapterNumber] || '',[m
[32m+[m[32m    pages: (c.pages || []).map((p: any) => ({[m
[32m+[m[32m      ...p,[m
[32m+[m[32m      imageUrl: pageImages[pageKey(c.chapterNumber, p.pageNumber)] || '',[m
[32m+[m[32m    })),[m
[32m+[m[32m  })),[m
[32m+[m[32m});[m
