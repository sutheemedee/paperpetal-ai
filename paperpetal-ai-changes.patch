[32m+[m[32mimport { useState, useEffect } from 'react';[m
[32m+[m
[32m+[m[32minterface BookImageProps {[m
[32m+[m[32m  src?: string;[m
[32m+[m[32m  generateFn?: () => Promise<string>;[m
[32m+[m[32m  width: string | number;[m
[32m+[m[32m  height: string | number;[m
