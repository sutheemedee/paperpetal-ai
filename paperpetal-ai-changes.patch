[32m+[m
[32m+[m[32mexport default ProtectedRoute;[m
[32m+[m[32mimport { createContext, useCallback, useContext, useMemo, useState } from 'react';[m
[32m+[m[32mimport { supabase } from '@/integrations/supabase/client';[m
[32m+[m[32mimport { useAuth } from './AuthProvider';[m
[32m+[m[32mimport { isUnlimitedPlanLike, METRIC_LABEL, PlanEntitlements, UsageMetric, usageRatio, usageTone } from '@/lib/plans';[m
[32m+[m[32mimport UpgradeModal, { UpgradeReason } from '@/components/account/UpgradeModal';[m
[32m+[m[32mimport QuotaAlertWatcher from '@/components/account/QuotaAlertWatcher';[m
[32m+[m
[32m+[m[32minterface ConsumeInput {[m
[32m+[m[32m  metric: UsageMetric;[m
[32m+[m[32m  quantity?: number;[m
[32m+[m[32m  operation: string;[m
[32m+[m[32m  projectId?: string | null;[m
[32m+[m[32m  model?: string | null;[m
[32m+[m[32m  format?: string;[m
[32m+[m[32m  metadata?: Record<string, unknown>;[m
[32m+[m[32m}[m
[32m+[m
[32m+[m[32minterface Ctx {[m
[32m+[m[32m  /** Server-verified quota consumption. Returns false when blocked (modal shown). */[m
[32m+[m[32m  consume: (input: ConsumeInput) => Promise<boolean>;[m
[32m+[m[32m  /** Non-consuming pre-check, e.g. before starting a long generation. */[m
[32m+[m[32m  check: (metric: UsageMetric, quantity?: number) => Promise<boolean>;[m
[32m+[m[32m  /** Feature gate from the plan entitlements. */[m
[32m+[m[32m  can: (feature: keyof PlanEntitlements) => boolean;[m
[32m+[m[32m  requireFeature: (feature: keyof PlanEntitlements, label: string) => boolean;[m
[32m+[m[32m  usage: (metric: UsageMetric) => { used: number; limit: number | null; ratio: number; tone: string; label: string; unlimited: boolean };[m
[32m+[m[32m  /** True for admin / unlimited operator accounts — no credit caps at all. */[m
[32m+[m[32m  unrestricted: boolean;[m
[32m+[m[32m  track: (event: string, props?: Record<string, unknown>) => void;[m
[32m+[m[32m  openUpgrade: (reason: UpgradeReason) => void;[m
[32m+[m[32m}[m
[32m+[m
[32m+[m[32mconst EntitlementsContext = createContext<Ctx | null>(null);[m
[32m+[m
[32m+[m[32mexport const EntitlementsProvider = ({ children }: { children: React.ReactNode }) => {[m
[32m+[m[32m  const { account, setAccount, user, isAdmin } = useAuth();[m
[32m+[m[32m  const [reason, setReason] = useState<UpgradeReason | null>(null);[m
[32m+[m[32m  /** Operator accounts (admin role or unlimited plan) ignore every credit/quota rule. */[m
[32m+[m[32m  const unrestricted = isAdmin || isUnlimitedPlanLike(account);[m
[32m+[m
[32m+[m[32m  const call = useCallback(async (body: Record<string, unknown>) => {[m
[32m+[m[32m    const { data, error } = await supabase.functions.invoke('entitlements', { body });[m
[32m+[m[32m    if (error) throw error;[m
[32m+[m[32m    return data;[m
[32m+[m[32m  }, []);[m
[32m+[m
[32m+[m[32m  const openUpgrade = useCallback((r: UpgradeReason) => setReason(r), []);[m
[32m+[m
[32m+[m[32m  const handleBlocked = useCallback([m
[32m+[m[32m    (data: any, metric: UsageMetric) => {[m
[32m+[m[32m      if (data.reason === 'daily_export_limit') {[m
[32m+[m[32m        openUpgrade({[m
[32m+[m[32m          kind: 'daily_export',[m
[32m+[m[32m          title: 'คุณใช้สิทธิ์ดาวน์โหลดของวันนี้ครบแล้ว',[m
[32m+[m[32m          detail: `ดาวน์โหลดวันนี้: ${data.exportsToday} / ${data.perDay} · ดาวน์โหลดครั้งถัดไปได้พรุ่งนี้`,[m
[32m+[m[32m          planCode: data.planCode,[m
[32m+[m[32m        });[m
[32m+[m[32m      } else if (data.reason === 'rate_limited') {[m
[32m+[m[32m        openUpgrade({[m
[32m+[m[32m          kind: 'rate_limited',[m
[32m+[m[32m          title: 'ระบบกำลังตรวจสอบการใช้งานที่สูงผิดปกติ',[m
[32m+[m[32m          detail: 'งานของคุณปลอดภัย กรุณาลองอีกครั้งในอีกสักครู่',[m
[32m+[m[32m          planCode: data.planCode,[m
[32m+[m[32m        });[m
[32m+[m[32m      } else {[m
[32m+[m[32m        openUpgrade({[m
[32m+[m[32m          kind: 'quota',[m
[32m+[m[32m          title: `คุณใช้ ${METRIC_LABEL[metric]} ครบตามแผนแล้ว`,[m
[32m+[m[32m          detail: `ปัจจุบัน: ${data.used} / ${data.limit} ${METRIC_LABEL[metric]} — โปรเจกต์ของคุณยังปลอดภัยและแก้ไขต่อได้`,[m
[32m+[m[32m          planCode: data.planCode,[m
[32m+[m[32m        });[m
[32m+[m[32m      }[m
[32m+[m[32m    },[m
[32m+[m[32m    [openUpgrade],[m
[32m+[m[32m  );[m
[32m+[m
[32m+[m[32m  const consume = useCallback([m
[32m+[m[32m    async (input: ConsumeInput) => {[m
[32m+[m[32m      if (unrestricted) {[m
[32m+[m[32m        // Operator accounts are completely unmetered in-app: no check, no counter, no ledger.[m
[32m+[m[32m        return true;[m
[32m+[m[32m      }[m
[32m+[m[32m      if (!user) {[m
[32m+[m[32m        openUpgrade({ kind: 'auth', title: 'เข้าสู่ระบบเพื่อใช้ AI', detail: 'สร้างบัญชีฟรีเพื่อเริ่มใช้งาน KIVORA' });[m
[32m+[m[32m        return false;[m
[32m+[m[32m      }[m
[32m+[m[32m      try {[m
[32m+[m[32m        const data = await call({ action: 'consume', ...input, quantity: input.quantity ?? 1 });[m
[32m+[m[32m        if (data?.account) setAccount({ ...(account as any), ...data.account });[m
[32m+[m[32m        if (!data?.allowed) {[m
[32m+[m[32m          handleBlocked(data, input.metric);[m
[32m+[m[32m          return false;[m
[32m+[m[32m        }[m
[32m+[m[32m        return true;[m
[32m+[m[32m      } catch {[m
[32m+[m[32m        return false;[m
[32m+[m[32m      }[m
[32m+[m[32m    },[m
[32m+[m[32m    [user, call, account, setAccount, handleBlocked, openUpgrade, unrestricted],[m
[32m+[m[32m  );[m
[32m+[m
[32m+[m[32m  const check = useCallback([m
[32m+[m[32m    async (metric: UsageMetric, quantity = 1) => {[m
[32m+[m[32m      if (unrestricted) return true;[m
[32m+[m[32m      if (!user) {[m
[32m+[m[32m        openUpgrade({ kind: 'auth', title: 'เข้าสู่ระบบเพื่อใช้ AI', detail: 'สร้างบัญชีฟรีเพื่อเริ่มใช้งาน KIVORA' });[m
[32m+[m[32m        return false;[m
[32m+[m[32m      }[m
[32m+[m[32m      try {[m
[32m+[m[32m        const data = await call({ action: 'check', metric, quantity });[m
[32m+[m[32m        if (data?.account) setAccount({ ...(account as any), ...data.account });[m
[32m+[m[32m        if (!data?.allowed) {[m
[32m+[m[32m          handleBlocked(data, metric);[m
[32m+[m[32m          return false;[m
[32m+[m[32m        }[m
[32m+[m[32m        return true;[m
[32m+[m[32m      } catch {[m
[32m+[m[32m        return false;[m
[32m+[m[32m      }[m
[32m+[m[32m    },[m
[32m+[m[32m    [user, call, account, setAccount, handleBlocked, openUpgrade, unrestricted],[m
[32m+[m[32m  );[m
[32m+[m
[32m+[m[32m  const can = useCallback([m
[32m+[m[32m    (feature: keyof PlanEntitlements) => unrestricted || account?.entitlements?.[feature] === true,[m
[32m+[m[32m    [account, unrestricted],[m
[32m+[m[32m  );[m
[32m+[m
[32m+[m[32m  const requireFeature = useCallback([m
[32m+[m[32m    (feature: keyof PlanEntitlements, label: string) => {[m
[32m+[m[32m      if (can(feature)) return true;[m
[32m+[m[32m      openUpgrade({[m
[32m+[m[32m        kind: 'feature',[m
[32m+[m[32m        title: `${label} ใช้ได้ในแผนที่สูงขึ้น`,[m
[32m+[m[32m        detail: `อัปเกรดเพื่อปลดล็อก ${label} พร้อมสิทธิ์ AI เพิ่มขึ้น`,[m
[32m+[m[32m        planCode: account?.planCode,[m
[32m+[m[32m      });[m
[32m+[m[32m      return false;[m
[32m+[m[32m    },[m
[32m+[m[32m    [can, openUpgrade, account],[m
[32m+[m[32m  );[m
[32m+[m
[32m+[m[32m  const usage = useCallback([m
[32m+[m[32m    (metric: UsageMetric) => {[m
[32m+[m[32m      const used = account?.counters?.[metric] ?? 0;[m
[32m+[m[32m      if (unrestricted) {[m
[32m+[m[32m        return { used, limit: null, ratio: 0, tone: 'ok', label: METRIC_LABEL[metric], unlimited: true };[m
[32m+[m[32m      }[m
[32m+[m[32m      const base = (account?.entitlements as any)?.[metric] ?? null;[m
[32m+[m[32m      const bonus = account?.bonus?.[metric] ?? 0;[m
[32m+[m[32m      const limit = base === null || base === undefined ? null : Number(base) + bonus;[m
[32m+[m[32m      const ratio = usageRatio(used, limit);[m
[32m+[m[32m      return { used, limit, ratio, tone: usageTone(ratio), label: METRIC_LABEL[metric], unlimited: false };[m
[32m+[m[32m    },[m
[32m+[m[32m    [account, unrestricted],[m
[32m+[m[32m  );[m
[32m+[m
[32m+[m[32m  const track = useCallback([m
[32m+[m[32m    (event: string, props?: Record<string, unknown>) => {[m
[32m+[m[32m      if (!user) return;[m
[32m+[m[32m      call({ action: 'track', event, props: props ?? {} }).catch(() => {});[m
[32m+[m[32m    },[m
[32m+[m[32m    [user, call],[m
[32m+[m[32m  );[m
[32m+[m
[32m+[m[32m  const value = useMemo<Ctx>([m
[32m+[m[32m    () => ({ consume, check, can, requireFeature, usage, track, openUpgrade, unrestricted: !!unrestricted }),[m
[32m+[m[32m    [consume, check, can, requireFeature, usage, track, openUpgrade, unrestricted],[m
[32m+[m[32m  );[m
[32m+[m
[32m+[m[32m  return ([m
[32m+[m[32m    <EntitlementsContext.Provider value={value}>[m
[32m+[m[32m      {children}[m
[32m+[m[32m      <QuotaAlertWatcher />[m
[32m+[m[32m      <UpgradeModal reason={reason} onClose={() => setReason(null)} />[m
[32m+[m[32m    </EntitlementsContext.Provider>[m
[32m+[m[32m  );[m
[32m+[m[32m};[m
[32m+[m
[32m+[m[32mexport const useEntitlements = () => {[m
[32m+[m[32m  const ctx = useContext(EntitlementsContext);[m
[32m+[m[32m  if (!ctx) throw new Error('useEntitlements must be used inside EntitlementsProvider');[m
[32m+[m[32m  return ctx;[m
[32m+[m[32m};[m
